# ==========================================================
# 🚀 YUE AI CONFIGURATION TEMPLATE (.env.example)
# Tạo file '.env' cùng thư mục và điền các giá trị thực tế của bạn
# ==========================================================

# ----------------------------------------------------------
# 1. XÁC THỰC DISCORD BOT
# ----------------------------------------------------------
DISCORD_TOKEN=your_discord_bot_token_here
CLIENT_ID=your_discord_client_id_here

# Kênh chat riêng nhận phản hồi tự động (không cần tag @yue)
SPECIAL_CHANNEL_NAME=con-vợ-ai
# Hậu tố đính kèm sau câu trả lời của Bot (ví dụ: [Yue Test 🧪] hoặc để trống)
BOT_REPLY_SUFFIX=

# ----------------------------------------------------------
# 2. API KEYS CHO CÁC DỊCH VỤ AI & GIỌNG NÓI
# ----------------------------------------------------------
# Danh sách Gemini API Keys (phân cách bằng dấu phẩy để xoay key tự động chống rate-limit)
GEMINI_API_KEYS=your_gemini_key_1,your_gemini_key_2,your_gemini_key_3

WIT_AI_TOKEN=your_wit_ai_token_here
GROQ_API_KEY=your_groq_api_key_here
FPT_AI_KEY=your_fpt_ai_key_here

# ----------------------------------------------------------
# 3. CẤU HÌNH OSU! API & BANCHO IRC
# ----------------------------------------------------------
OSU_CLIENT_ID=your_osu_client_id
OSU_CLIENT_SECRET=your_osu_client_secret
OSU_API_KEY=your_osu_api_v1_key

ORDR_API_KEY=your_ordr_api_key

BANCHO_IRC_USERNAME=your_osu_irc_username
BANCHO_IRC_PASSWORD=your_osu_irc_password

# ----------------------------------------------------------
# 4. CỜ ĐIỀU KHIỂN TÍNH NĂNG (FEATURE FLAGS)
# ----------------------------------------------------------
# 📌 MẪU A: DÙNG CHO MÁY LOCAL PC (BOT TEST FULL TÍNH NĂNG)
ENABLE_VOICE=true     # Cho phép gọi lệnh Voice (.join, .listen, .leave)
ENABLE_CANVAS=true    # Cho phép vẽ thẻ hình ảnh (.profile, .stat)
ENABLE_ROSU_PP=true   # Cho phép tính PP offline
ENABLE_BANCHO=false   # TẮT Bancho ở Local để tránh xung đột nick IRC với Server 24/7

# 📌 MẪU B: DÙNG CHO SERVER FREE 24/7 (BOT CHÍNH LITE MODE)
# (Copy các dòng này khi cấu hình trên Render / Koyeb / VPS)
# ENABLE_VOICE=false
# ENABLE_CANVAS=false
# ENABLE_ROSU_PP=false
# ENABLE_BANCHO=true
